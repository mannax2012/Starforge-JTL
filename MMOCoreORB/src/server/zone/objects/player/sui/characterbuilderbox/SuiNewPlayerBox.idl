package server.zone.objects.player.sui.newplayerbox;

import engine.service.proto.BaseMessage;

import server.zone.objects.creature.CreatureObject;
import server.zone.objects.player.sui.listbox.SuiListBox;

include templates.tangible.NewPlayerMenuNode;
include server.zone.objects.player.sui.SuiWindowType;

class SuiNewPlayerBox extends SuiListBox {
	protected transient final NewPlayerMenuNode rootNode;
	protected transient final NewPlayerMenuNode currentNode;

	public SuiNewPlayerBox(CreatureObject player, final NewPlayerMenuNode root) {
		super(player, SuiWindowType.NEW_PLAYER_LIST, SuiListBox.HANDLETHREEBUTTON);

		Logger.setLoggingName("SuiNewPlayerBox");

		setPromptTitle("New Player Terminal");

		setPromptText("Provided below are items which the staff feel are acceptable starting items. Please select only the items which you require.");

		rootNode = root;

		currentNode = root;
	}

	@local
	public native BaseMessage generateMessage();

	@local
	public native final NewPlayerMenuNode getCurrentNode();

	@local
	public native void setCurrentNode(final NewPlayerMenuNode node);

	public boolean isNewPlayerBox() {
		return true;
	}
}
